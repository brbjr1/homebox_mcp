# ---------------------------------------------------------------------------
# Homebox connection
# ---------------------------------------------------------------------------
# Base URL of your self-hosted Homebox instance (no trailing slash, no /api).
HOMEBOX_URL=http://homebox:7745

# Credentials used to log in to Homebox and obtain a bearer token.
# Create a dedicated Homebox user for this agent rather than reusing your own.
HOMEBOX_USERNAME=agent@example.com
HOMEBOX_PASSWORD=change-me

# The human-facing web UI base URL, used only to build clickable item/
# location links for labels_generate_qr_sheet's QR codes. Leave unset to
# reuse HOMEBOX_URL -- set this separately only when your web UI and API
# are served from different hosts/ports (e.g. behind separate reverse
# proxy routes).
HOMEBOX_WEB_URL=

# ---------------------------------------------------------------------------
# Bulk-action safety
# ---------------------------------------------------------------------------
# Ceiling on how many items actions_tag_subtree / actions_attach_photo_by_tag
# will discover and modify/upload to in one call. Without one, a broad root
# item or a popular tag could fire hundreds of writes with no preview. The
# result reports `truncated: true` rather than silently continuing past it.
MAX_BULK_ACTION_ITEMS=500

# ---------------------------------------------------------------------------
# Safety switch
# ---------------------------------------------------------------------------
# Y = only read/lookup tools are registered with MCP clients — every
#     create/update/delete tool is left out entirely, so a client (or the
#     model driving it) cannot call it no matter what it's asked to do.
# N = full read & write access.
READONLY=Y

# ---------------------------------------------------------------------------
# MCP server transport
# ---------------------------------------------------------------------------
# "stdio" (default): a client spawns this process and pipes its
# stdin/stdout directly — for a same-host/CLI-managed install.
# "http": serve MCP over Streamable HTTP as an always-on service instead —
# for a client on a different host/container, or the Docker image (which
# sets this to "http" itself; see docker-compose.yml). See README.md,
# "Running as an HTTP service".
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp

# Required in practice whenever MCP_TRANSPORT=http: every request must
# carry a matching `Authorization: Bearer <this>` header, checked with a
# constant-time compare. Leave unset only if you've deliberately decided
# the network path here (private LAN/VPN/Tailscale only) is trusted on
# its own — an unset token on an otherwise reachable port lets anyone who
# can reach it drive every tool this server exposes (Homebox reads, and
# writes unless READONLY=Y). Generate one with e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# Max JSON request body size (bytes) for MCP_TRANSPORT=http. Photo uploads
# (items_attachment_add, actions_attach_photo_by_tag) and CSV imports
# (items_import) are base64-encoded inside that same JSON-RPC body, and
# Express's default 100KB limit rejects a real photo/import long before the
# tool handler runs. Default 10485760 (10MiB); raise it if you upload
# larger photos.
MCP_HTTP_BODY_LIMIT_BYTES=10485760

# ---------------------------------------------------------------------------
# Upload-link page (items_upload_link)
# ---------------------------------------------------------------------------
# A browser-facing page (no login) that lets someone attach several
# photos/files to one item themselves, for MCP clients that only ever give
# the model vision access to a chat photo -- never its raw bytes (claude.ai
# web, mobile, and desktop app all behave this way; only Claude Code, given
# a real file path, can read actual bytes). items_upload_link mints a
# signed, time-limited, single-item link to this page.
#
# Required whenever items_upload_link is exposed (i.e. whenever
# MCP_TRANSPORT=http) -- HMAC-SHA256 key for signing those links.
# Deliberately separate from MCP_AUTH_TOKEN: this secret ends up embedded in
# a URL that gets pasted into chat and handed to end users, so a leaked
# upload link must not be replayable against the MCP endpoint itself, and
# rotating one must not force rotating the other. Generate with
# `openssl rand -hex 32`.
UPLOAD_LINK_SECRET=

# How long a minted upload link stays valid, in seconds. Default 3600 (1h).
UPLOAD_LINK_TTL_SECONDS=3600

# Path the upload page is served on (must match a reverse-proxy route to
# this MCP_HTTP_PORT, same as MCP_HTTP_PATH does for /mcp).
UPLOAD_PATH=/upload

# Max multipart body size (bytes) for one upload-page submission -- several
# full-resolution phone photos in one batch, not base64-inflated like the
# /mcp JSON body. Default 52428800 (50MiB).
UPLOAD_BODY_LIMIT_BYTES=52428800
